		<style>
            :root {
                --text: #0a0a0a;
                --muted: #6b7280;
                --border: #e5e7eb;
                --accent: #2563eb;
                --sidebar-w: 52px;
            }

            html, body {
				margin: 0;
				padding: 0;
				min-height: 100vh;
				background: #fafafa;
				color: var(--text);
				font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
                line-height: 1.6;
                scroll-behavior: smooth;
			}

			body {
				display: flex;
				flex-direction: column;
			}

			.container {
				flex: 1;
				max-width: 720px;
				margin: 0 auto;
				padding: 32px 20px 64px;
			}

            .nav {
				position: fixed;
				top: 50%;
				left: 20px;
				transform: translateY(-50%);
                width: var(--sidebar-w);
                padding: 14px;
				border: 1px solid var(--border);
				border-radius: 999px;
				background: rgba(255,255,255,0.75);
				backdrop-filter: saturate(180%) blur(8px);
				box-shadow: 0 2px 8px rgba(0,0,0,0.04);
				display: flex;
				flex-direction: column;
                align-items: center;
                gap: 10px;
				z-index: 10;
			}

            .nav a {
				color: var(--text);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				justify-content: center;
                width: 32px;
                height: 32px;
				border: 1px solid transparent;
				border-radius: 999px;
				transition: transform .15s ease, border-color .15s ease, background .15s ease;
				will-change: transform;
                position: relative;
			}

            .nav a:hover { transform: scale(1.05); border-color: #cfd3d8; background: rgba(0,0,0,0.03); color: var(--accent); }
            .nav a.active { border-color: var(--accent); background: rgba(37,99,235,0.07); color: var(--accent); }

            .nav a:hover::after {
                content: attr(data-tip);
                position: absolute;
                left: calc(100% + 8px);
                top: 50%;
                transform: translateY(-50%);
                background: #0a0a0a;
                color: #fff;
                border-radius: 6px;
                padding: 4px 8px;
                font-size: 12px;
                white-space: nowrap;
                pointer-events: none;
                box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            }

			@media (max-width: 800px) {
				.nav { display: none; }
			}

			@media (min-width: 801px) {
				.container { padding-left: 20px; }
			}

			h1 {
				font-size: 30px;
				margin: 1px 0 4px;
				font-weight: 600;
				display: inline-block;
				transition: transform .15s ease;
				will-change: transform;
			}

			h1:hover { transform: scale(1.05); }

			.link-section a {
				color: inherit;
				text-decoration: underline;
			}

			.avatar {
				display: block;
				width: 150px;
				height: 150px;
				border-radius: 999px;
				object-fit: cover;
				border: 1px solid var(--border);
			}

			.tag {
				margin: 0;
				font-size: 18px;
				color: var(--accent);
			}

			.sep {
				margin: 6px 0;
			}

			.blurb {
				margin: 0 0 24px 0;
			}

			.section {
				margin-top: 44px;
				padding-top: 28px;
				border-top: 1px solid var(--border);
			}

			.section h1 {
				font-size: 11px;
				font-weight: 700;
				letter-spacing: .13em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 14px;
			}

			.list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.bullets { list-style: disc; padding-left: 20px; }
			.sublist { list-style: circle; padding-left: 18px; margin: 4px 0 0; }

			.list li {
				margin: 8px 0 0 0;
			}

			.muted { color: var(--muted); }
			.muted a, .sublist a { color: var(--accent); text-decoration: none; }
			.muted a:hover, .sublist a:hover { text-decoration: underline; }

			.role { margin-top: 8px; }
			.role-head a { color: var(--text); text-decoration: none; }
			.role-head a:hover { color: var(--accent); }
            .role-head { font-size: 15px; }
            .role-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
            .role-date { text-align: right; font-size: 14px; }
            .role-loc { margin: 4px 0; }

			.footer {
				border-top: 1px solid var(--border);
				padding: 16px;
				text-align: center;
				color: var(--muted);
			}

			.skills-group { margin-top: 12px; }
			.skills-label { font-size: 18px; font-weight: 500; margin-bottom: 6px; text-transform: lowercase; }
			.chips { display: flex; flex-wrap: wrap; gap: 8px; }
			.chip {
				display: inline-flex;
				align-items: center;
				padding: 4px 10px;
				border: 1px solid #000000;
				border-radius: 999px;
				font-size: 12px;
				font-weight: 600;
				color: #000000;
				background: transparent;
				letter-spacing: .01em;
				transition: transform .15s ease, border-color .15s ease, color .15s ease;
				will-change: transform;
			}

			.chip:hover { transform: scale(1.05); color: #000000; }

			.contact-actions {
				display: flex;
				align-items: center;
				gap: 10px;
				flex-wrap: wrap;
			}

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 6px 12px;
				border: 2px solid #000000;
				border-radius: 999px;
				text-decoration: none;
				background: transparent;
				color: var(--text);
				font-weight: 500;
				font-size: 14px;
				cursor: pointer;
				transition: transform .15s ease, border-color .15s ease;
				will-change: transform;
				gap: 8px;
			}

			.btn:hover { transform: scale(1.05); border-color: #000000; }
			.btn:active { transform: scale(0.98); }

			.btn.secondary { color: var(--muted); }

			.social {
				display: flex;
				gap: 14px;
				margin-top: 8px;
			}

			.icon {
				color: var(--text);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 34px;
				height: 34px;
				border: 1px solid var(--border);
				border-radius: 999px;
				text-decoration: none;
				transition: transform .25s ease;
				will-change: transform;
			}

			.icon:hover { transform: scale(1.05); }

			.email-container {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.email {
				color: var(--text);
				text-decoration: none;
				transition: transform .15s ease;
				display: inline-block;
				will-change: transform;
			}

			.email:hover { transform: scale(1.05); }

		</style>
        <script>
            const sections = [
                { id: 'home', linkIndex: 0 },
                { id: 'research', linkIndex: 1 },
                { id: 'experience', linkIndex: 2 },
                { id: 'projects', linkIndex: 3 },
                { id: 'skills', linkIndex: 4 },
                { id: 'awards', linkIndex: 5 },
                { id: 'contact', linkIndex: 6 },
            ];

            const nav = document.querySelector('.nav');
            const links = nav ? Array.from(nav.querySelectorAll('a')) : [];

            if ('IntersectionObserver' in window && links.length) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        const idx = sections.findIndex(s => s.id === entry.target.id);
                        if (idx !== -1) {
                            const link = links[sections[idx].linkIndex];
                            if (entry.isIntersecting) {
                                link.classList.add('active');
                            } else {
                                link.classList.remove('active');
                            }
                        }
                    });
                }, { rootMargin: '-35% 0px -55% 0px', threshold: 0.1 });

                sections.forEach(s => {
                    const el = document.getElementById(s.id);
                    if (el) observer.observe(el);
                });
            }

            window.addEventListener('keydown', (e) => {
                const activeEl = document.activeElement;
                if (activeEl && ['INPUT', 'TEXTAREA'].includes(activeEl.tagName)) return;
                const keyToIndex = new Map([ ['1', 0], ['2', 1], ['3', 2], ['4', 3], ['5', 4], ['6', 5], ['7', 6] ]);
                const idx = keyToIndex.get(e.key);
                if (idx !== undefined && links[idx]) {
                    e.preventDefault();
                    links[idx].click();
                }
            });
        </script>
	</body>
</html>
